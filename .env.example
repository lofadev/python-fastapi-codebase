# Database connection string (async driver required) — matches the db service in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app

# Secret key for JWT signing (required, at least 32 characters) — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# JWT access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS allowed origins (JSON array)
# CORS_ORIGINS=["http://localhost:3000"]
